<?php

namespace App\Http\Controllers\{{ module }};

use App\Http\Controllers\Controller;
use App\Services\{{ name }}Service;

 use Illuminate\Http\Request;
    use App\Models\{{ name }};

    class {{ name }}Controller extends Controller
    {
        public function __construct(
            protected {{ name }}Service ${{ varName }}Service
        ) {}

        // Liste des {{ varName }}s
        public function index()
        {
            ${{ varName }}s = $this->{{ varName }}Service->getAll{{ name }}s();
            return view('web.{{ varName }}.index', compact('{{ varName }}s'));
        }

        // Page pour créer un nouveau {{ varName }}
        public function create()
        {
            return view('web.{{ varName }}.create');
        }

        // Sauvegarde d'un nouveau {{ varName }}
        public function store(Request $request)
        {
            $data = $request->validate([
                'title' => 'required|string|max:255',
                'date' => 'required|date',
                'capacity' => 'required|integer',
            ]);

            $this->{{ varName }}Service->create($data);
            return redirect()->route('{{ varName }}.index');
        }

        // Page pour afficher un {{ varName }}
        public function show({{ name }} ${{ varName }})
        {
            return view('web.{{ varName }}.show', compact('{{ varName }}'));
        }


        // Page pour éditer un {{ varName }} existant
        public function edit({{ name }} ${{ varName }})
        {
            return view('web.{{ varName }}.edit', compact('{{ varName }}'));
        }

        // Mise à jour d'un {{ varName }} existant
        public function update(Request $request, {{ name }} ${{ varName }})
        {
            $data = $request->validate([
                'title' => 'required|string|max:255',
                'date' => 'required|date',
                'capacity' => 'required|integer',
            ]);

            $this->{{ varName }}Service->update(${{ varName }}, $data);

            return redirect()->route('{{ varName }}.index');
        }

        // Supprimer un {{ varName }}
        public function destroy({{ name }} ${{ varName }})
        {
            $this->{{ varName }}Service->delete(${{ varName }});
            return redirect()->route('{{ varName }}.index');
        }
    }

