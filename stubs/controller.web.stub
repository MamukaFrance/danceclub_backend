<?php

namespace App\Http\Controllers\{{ module }};

use App\Http\Controllers\Controller;
use App\Services\{{ name }}Service;
use Illuminate\Http\Request;
use App\Http\Requests\{{ name }}Request;
use App\Models\{{ name }};
use App\Exceptions\{{ name }}Exception;

    class {{ name }}Controller extends Controller
    {
        public function __construct(protected {{ name }}Service ${{ varName }}Service)
        {             
            $this->authorizeResource({{ name }}::class, '{{ varName }}');
            $this->middleware('role:admin|editor')->only(['create', 'store', 'edit', 'update']);
        }

        // Liste des {{ varName }}s
        public function index()
        {
            ${{ varName }}s = $this->{{ varName }}Service->getAll{{ name }}s();
            return view('web.pages.{{ route }}s.index', compact('{{ varName }}s'));
        }

        // Page pour créer un nouveau {{ varName }}
        public function create()
        {
            return view('web.pages.{{ route }}s.create');
        }

        // Sauvegarde d'un nouveau {{ varName }}
        public function store({{ name }}Request $request)
        {
            try {
                $data = $request->validated();
                $this->{{ varName }}Service->create($data);
                return redirect()
                    ->route('{{ route }}s.index')
                    ->with('success', '{{ name }} ajouté avec succès');
            } catch ({{ name }}Exception $e) {
                return redirect()
                    ->back()
                    ->withInput()
                    ->with('error', $e->getMessage());
            }
        }

        // Page pour afficher un {{ varName }}
        public function show({{ name }} ${{ varName }})
        {
            return view('web.pages.{{ route }}.show', compact('{{ varName }}'));
        }


        // Page pour éditer un {{ varName }} existant
        public function edit({{ name }} ${{ varName }})
        {
            return view('web.pages.{{ route }}s.edit', compact('{{ varName }}'));
        }

        // Mise à jour d'un {{ varName }} existant
        public function update({{ name }}Request $request, {{ name }} ${{ varName }})
        {
            try {
                $data = $request->validated();
                ${{ varName }} = $this->{{ varName }}Service->update(${{ varName }}, $data);
                if (! ${{ varName }}->wasChanged()) {
                    return redirect()
                        ->route('{{ route }}s.index')
                        ->with('info', 'Aucune modification détectée');
                }

                return redirect()
                    ->route('{{ route }}s.index')
                    ->with('success', '{{ name }} mis à jour avec succès');
            } catch ({{ name }}Exception $e) {
                return redirect()
                    ->back()
                    ->withInput()
                    ->with('error', $e->getMessage());
            } 
        }

        // Supprimer un {{ varName }}
        public function destroy({{ name }} ${{ varName }})
        {
            try{
                $this->{{ varName }}Service->delete(${{ varName }});
                return redirect()
                    ->route('{{ route }}s.index')
                    ->with('success', '{{ name }} supprimé avec succès');;
            }catch ({{ name }}Exception $e) {
                return redirect()
                    ->back()
                    ->withInput()
                    ->with('error', $e->getMessage());
            }
        }
    }

